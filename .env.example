# Copy to .env and adjust. Defaults match docker-compose.yml (dev only).
# When running Nest on your machine with MySQL in Docker, use 127.0.0.1.
# The `api` service in docker-compose sets DB_HOST=mysql automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=hostel
DB_PASSWORD=hostel_dev
DB_DATABASE=hostel

# Local dev only: auto-create/update tables from entities (do not use in production)
TYPEORM_SYNC=true

# JWT (required in production; dev falls back if unset — see src/modules/auth/jwt-secret.util.ts)
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (default 7 days)
JWT_EXPIRES_SEC=604800
